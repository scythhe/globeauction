DATABASE_URL=postgres://localhost:5432/globeauction_dev
TEST_DATABASE_URL=postgres://localhost:5432/globeauction_test

# Number of trusted reverse-proxy hops in front of this process (Cloudflare,
# nginx, a load balancer). Leave unset in local dev — there is no proxy.
# Set to the real hop count in production, or every per-IP rate limiter
# (login, registration, bidding) collapses into one shared bucket, since
# req.ip would be the proxy's address for every request instead of the
# client's.
# TRUST_PROXY=1

# Photo storage (§11). S3-compatible — same client works against a local
# MinIO stand-in or real Cloudflare R2, only these values change.
#
# Local MinIO (brew install minio; brew services start minio):
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=globeauction-photos
S3_PUBLIC_BASE_URL=http://localhost:9000/globeauction-photos
S3_REGION=auto
#
# Real Cloudflare R2, once an account exists:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<r2 access key id>
# S3_SECRET_ACCESS_KEY=<r2 secret access key>
# S3_BUCKET=globeauction-photos
# S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev   # or a custom domain fronting the bucket
